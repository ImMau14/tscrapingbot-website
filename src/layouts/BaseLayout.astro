---
import "@/tailwind.css"

import NavBar from "@components/NavBar.astro"
import { BgWebImage } from "@components/tsx/BgWebImage.tsx"

import type { TranslationDictionary } from "@i18n/utils"

interface Props {
  className?: string
  t: TranslationDictionary
}

const { t, className }: Props = Astro.props
---

<html lang={t.lang} class="h-full w-full bg-purple-950">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06020f" />
    <meta name="description" content={t.home.description} />
    <title>{t.home.title} - TScrapingBot</title>
  </head>
  <body class:list={["w-full h-full overflow-hidden", className]}>
    <div class="w-full h-full relative grid grid-cols-1 grid-rows-[auto_1fr]">
      <NavBar pages={t.NavBar} />
      <slot />
    </div>
    <BgWebImage />
  </body>
</html>
