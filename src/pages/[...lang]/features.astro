---
export const prerender = true

import BaseLayout from "@layouts/BaseLayout.astro"

import { locales, getTranslations } from "@i18n/utils.ts"
import { FeaturesPage } from "@components/tsx/FeaturesPage/FeaturesPage.tsx"

export async function getStaticPaths() {
  const languages = locales
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<BaseLayout {t} className="overflow-y-auto">
  <FeaturesPage className="p-4 my-20 md:my-10" featuresList={t.features.featuresList} title={t.features.title} />
</BaseLayout>
