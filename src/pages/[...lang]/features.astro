---
import '@styles/global.css'
import '@styles/fonts.css'

import { locales, getTranslations } from '@i18n/utils.ts'
import { NavBar } from '@components/tsx/NavBar/NavBar.tsx'
import { FeaturesPage } from '@components/tsx/FeaturesPage/FeaturesPage.tsx'
import { BgWebImage } from '@components/tsx/BgWebImage.tsx'

export async function getStaticPaths() {
	const languages = locales
	return languages.map(lang => ({
		params: { lang },
		props: { lang }
	}))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<html lang={lang} class="w-full h-full bg-purple-950">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06020f" />
    <meta name="description" content={t.features.metaContent} />
    <title>{ t.features.title } - TScrapingBot</title>
  </head>
  <body class="w-full flex flex-col relative scrollbar-thin scrollbar-thumb-purple-450/40 scrollbar-track-purple-800">
    <div class="w-full flex flex-col">
      <NavBar pages={t.NavBar} client:load />
      <FeaturesPage className="p-4 my-20 md:my-10" featuresList={t.features.featuresList} title={t.features.title} client:load />
    </div>
    <BgWebImage client:visible />
  </body>
</html>
