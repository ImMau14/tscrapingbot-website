---
import '@styles/global.css'

import { locales, getTranslations } from '@i18n/utils.ts'

export async function getStaticPaths() {
	const languages = locales
	return languages.map(lang => ({
		params: { lang },
		props: { lang }
	}))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<html lang={lang} class="w-full h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000" />
    <title>{ t.inProcess.title }</title>
  </head>
  <body class="bg-black flex p-4 flex-col items-center justify-center h-full w-full">
      <main class="flex flex-col gap-2 justify-center">
        <h1 class="text-purple-200 text-4xl font-bold text-heading tracking-wide">
          { t.inProcess.header }
        </h1>
        <p class="text-green-300 text-md text-body tracking-wide">
          { t.inProcess.description }
        </p>
      </main>
  </body>
</html>
