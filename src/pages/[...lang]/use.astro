---
export const prerender = true

import "@/tailwind.css"

import { locales, getTranslations } from "@i18n/utils.ts"
import { BgWebImage } from "@components/tsx/BgWebImage.tsx"
import NavBar from "@components/NavBar.astro"
import { UsePage } from "@components/tsx/UsePage/UsePage.tsx"

export async function getStaticPaths() {
  const languages = locales
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<html {lang} class="w-full h-full bg-purple-950">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t.use.metaContent} />
    <meta name="theme-color" content="#06020f" />
    <title>{t.use.title} - TScrapingBot</title>
  </head>
  <body class="w-full h-full flex flex-col">
    <div class="w-full h-full flex flex-col relative">
      <NavBar pages={t.NavBar} />
      <UsePage
        use={t.use}
        className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col gap-2 w-full md:w-[70%]"
      />
    </div>
    <BgWebImage />
  </body>
</html>
