---
export const prerender = true

import BaseLayout from "@layouts/BaseLayout.astro"

import { locales, getTranslations } from "@i18n/utils.ts"
import { UsePage } from "@components/tsx/UsePage/UsePage.tsx"

export async function getStaticPaths() {
  const languages = locales
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<BaseLayout {t} seo={t.use.seo}>
  <UsePage
    use={t.use}
    className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col gap-2 w-full md:w-[70%]"
  />
</BaseLayout>
