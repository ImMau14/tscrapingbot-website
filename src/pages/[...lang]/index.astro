---
export const prerender = true

import BaseLayout from "@layouts/BaseLayout.astro"

import { locales, getTranslations } from "@i18n/utils.ts"
import { HomePage } from "@components/tsx/HomePage/HomePage.tsx"

export async function getStaticPaths() {
  const languages = locales
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }))
}

const { lang } = Astro.params
const t = await getTranslations(lang)
---

<BaseLayout {t} seo={t.home.seo}>
  <HomePage
    className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-8 justify-center"
    description={t.home.description}
    button={t.home.button}
  />
</BaseLayout>
